{
  "name": "offerdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop:start": "npm run desktop:build && electron desktop",
    "desktop:pack": "npm run desktop:build && electron-builder --config electron-builder.yml --dir --publish never",
    "desktop:dist": "npm run desktop:build && electron-builder --config electron-builder.yml --publish never",
    "desktop:test": "npm run desktop:build && playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/postcss": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "description": "开源的本地岗位与投递管理桌面应用",
  "author": "mzh0221",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzh0221/offerdesk.git"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.4"
  }
}
