# Local-only use: browser storage, no account or cloud services required.
# The existing local storage mode uses the historical name demo; AI is not connected.
APP_MODE=demo
# Legacy cloud configuration below is outside the current local-only requirements.
# Setting a model key alone does not enable extraction in local mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
# Legacy cloud cleanup endpoint secret; not required for local use.
CRON_SECRET=
